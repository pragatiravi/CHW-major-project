# ==============================================================================
# Community Health Worker (CHW) Healthcare Toolkit — Environment Configuration Template
# Copy this file to `.env` for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Remote / Production Database)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard: Project Settings > API
# Required for PostgreSQL persistence, Supabase Auth, and Row-Level Security (RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 2. Demo & Evaluator Mode Flag
# ------------------------------------------------------------------------------
# When 'true': Enables built-in demo persona cards for university viva / evaluator review.
# When 'false' (or omitted in production builds): Gating strictly disables all hardcoded
# demo credentials, requiring verified Supabase Auth accounts.
VITE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 3. Clinical AI Assistant Configuration (Vercel Serverless Function: /api/chat)
# ------------------------------------------------------------------------------
# Set this in your Vercel Project Environment Variables (NEVER expose to client bundle).
# Configures the Gemini API proxy endpoint with clinical scope limiting and 108 emergency detection.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Administrative Seed Key (Local CLI Tooling Only)
# ------------------------------------------------------------------------------
# Used ONLY in scripts/seed-users.js to provision initial demo accounts or setup the first admin.
# NEVER commit or expose the service_role key to Vite or client-side code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
