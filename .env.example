# Supabase Project Configuration (Obtain from Project Settings > API)
# Required for PostgreSQL database persistence, Supabase Auth, and Row-Level Security
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Optional: Local Provisioning Service Role Key (Used ONLY in scripts/seed-users.js, NEVER in client code)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
