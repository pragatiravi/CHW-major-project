# One-click role switching bypasses credential validation and is only intended
# for controlled evaluator sessions with synthetic data.
VITE_ENABLE_DEMO_ACCESS=true

# Public browser credentials from Supabase Project Settings > API.
# Keep every server secret key out of all VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
