# Server-only provisioning values. Copy to .env.supabase.local.
# Never prefix the server secret key with VITE_ or commit the local file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_DEMO_PASSWORD=use-a-strong-temporary-password
